#!/usr/bin/env python3
"""opaquify — keep secret VALUES out of sight, keep the file readable.

An opaquify env file looks and reads like a normal env file; only the lines
whose value was sealed are ciphertext. Sealed values are decrypted into the
environment of a child process at run time — never written to disk, never
printed, never passed through argv.

  opaquify keygen                        create the key (0600)
  printf 'secret' | opaquify seal <f> KEY  encrypt one value into the file
  opaquify run <f> -- <command...>       decrypt + export env to the command

One key per user (default ~/.local/state/opaquify/main.key), no key names to
manage. Honest model: this protects against *accidental* exposure (cat, logs,
agent turns). A same-user process that deliberately reads the key file can
always win — that trust boundary needs a separate broker.
"""
import base64
import os
import subprocess
import sys

VERSION = "0.2.0"
MARKER = "age1:"          # a sealed value starts with this

DEFAULT_DIR = os.path.join(
    os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"),
    "opaquify",
)


def _age(): return os.environ.get("OPAQIFY_AGE_BIN", "age")
def _age_keygen(): return os.environ.get("OPAQIFY_AGE_KEYGEN_BIN", "age-keygen")


def key_path() -> str:
    """OPAQIFY_KEY_PATH wins; otherwise one key per user."""
    return os.environ.get("OPAQIFY_KEY_PATH") or os.path.join(DEFAULT_DIR, "main.key")


def die(msg: str, code: int = 1) -> None:
    print(f"opaquify: {msg}", file=sys.stderr)
    sys.exit(code)


# -- crypto: shell out to age; the plaintext never crosses our stdout --------

def encrypt_value(key: str, value: str) -> str:
    p = subprocess.run([_age(), "-e", "-i", key], input=value.encode(),
                       capture_output=True)
    if p.returncode != 0:
        die(f"age encrypt failed: {p.stderr.decode(errors='replace').strip()}")
    return MARKER + base64.b64encode(p.stdout).decode()


def decrypt_value(key: str, sealed: str) -> str:
    p = subprocess.run([_age(), "-d", "-i", key],
                       input=base64.b64decode(sealed[len(MARKER):]),
                       capture_output=True)
    if p.returncode != 0:
        die(f"age decrypt failed: {p.stderr.decode(errors='replace').strip()}")
    return p.stdout.decode()


# -- file handling -----------------------------------------------------------

def parse_env(text: str, key: str) -> dict:
    """KEY=VALUE lines -> dict; sealed values decrypted. Deliberately minimal:
    no expansion, no conditionals, nothing shell-like, so it stays auditable."""
    env = {}
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, v = line.split("=", 1)
        if v.startswith(MARKER):
            v = decrypt_value(key, v)
        else:
            v = v.strip()
            if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'":
                v = v[1:-1]
        env[k.strip()] = v
    return env


def read_text(path: str) -> str:
    if not os.path.exists(path):
        return ""
    with open(path, encoding="utf-8") as f:
        return f.read()


def write_text(path: str, text: str) -> None:
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        f.write(text)


# -- commands ----------------------------------------------------------------

def cmd_keygen() -> None:
    path = key_path()
    if os.path.exists(path):
        die(f"key already exists: {path}  (remove it to start over)")
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    os.umask(0o077)
    p = subprocess.run([_age_keygen(), "-o", path], capture_output=True)
    if p.returncode != 0:
        die(f"age-keygen failed: {p.stderr.decode(errors='replace').strip()}")
    os.chmod(path, 0o600)
    pub = next((l.split(": ", 1)[1].strip() for l in read_text(path).splitlines()
                if l.startswith("# public key:")), "?")
    print(f"created {path} (0600)  public key: {pub}")


def cmd_seal(path: str, key_name: str) -> None:
    """The value comes from stdin ONLY — never from argv (argv shows up in ps,
    shell history and agent transcripts)."""
    value = sys.stdin.read()
    k = key_path()
    if not os.path.exists(k):
        die(f"key not found: {k} (run: opaquify keygen)")
    sealed = f"{key_name}={encrypt_value(k, value)}"
    lines = read_text(path).splitlines()
    if not lines:
        lines = ["# opaquify env file — sealed values start with age1:",
                 "# every other line stays readable as written", ""]
    out, replaced = [], False
    for line in lines:
        if line.partition("=")[0].strip() == key_name:
            out.append(sealed)
            replaced = True
        else:
            out.append(line)
    if not replaced:
        out.append(sealed)
    write_text(path, "\n".join(out) + "\n")
    print(sealed)


def cmd_run(path: str, command: list[str]) -> None:
    if not os.path.exists(path):
        die(f"no such file: {path}")
    k = key_path()
    if not os.path.exists(k):
        die(f"key not found: {k} (run: opaquify keygen)")
    child_env = dict(os.environ)
    child_env.update(parse_env(read_text(path), k))
    sys.exit(subprocess.run(command, env=child_env).returncode)


USAGE = """opaquify — keep secret values out of sight, keep the file readable

usage:
  opaquify keygen
  printf 'secret' | opaquify seal <file> KEY
  opaquify run <file> -- <command...>

env:
  OPAQIFY_KEY_PATH        key file (default: ~/.local/state/opaquify/main.key)
  OPAQIFY_AGE_BIN         age binary (default: age)
  OPAQIFY_AGE_KEYGEN_BIN  age-keygen binary (default: age-keygen)"""


def main(argv: list[str]) -> None:
    if len(argv) < 2 or argv[1] in ("--help", "-h", "help"):
        print(USAGE)
        sys.exit(0 if len(argv) > 1 else 2)
    cmd = argv[1]
    if cmd in ("--version", "-V"):
        print(f"opaquify {VERSION}")
    elif cmd == "keygen":
        if len(argv) != 2:
            die("usage: opaquify keygen", 2)
        cmd_keygen()
    elif cmd == "seal":
        if len(argv) != 4:
            die("usage: printf 'secret' | opaquify seal <file> KEY", 2)
        cmd_seal(argv[2], argv[3])
    elif cmd == "run":
        if len(argv) < 4 or argv[3] != "--":
            die("usage: opaquify run <file> -- <command...>", 2)
        cmd_run(argv[2], argv[4:])
    else:
        die(f"unknown command: {cmd}", 2)


if __name__ == "__main__":
    main(sys.argv)
